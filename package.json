{
  "name": "anki-programming-flashcards",
  "version": "3.2.8",
  "description": "Learning to code with Anki",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "npm run css && npm run demo && npm run data",
    "css": "npx lessc source/style/main.less ./build/style/main.css",
    "data": "npm run data-card && npm run data-code && npm run data-code-reverse",
    "data-card": "pandoc --from markdown-auto_identifiers source/data/card.md -o ./build/data/card.html",
    "data-code": "pandoc source/data/code.md -o ./build/data/code.html",
    "data-code-reverse": "pandoc source/data/code.html -t gfm -o ./build/data/code.md",
    "demo": "npm run demo-draw && npm run demo-simple && npm run demo-missing",
    "demo-draw": "npx mustache -p source/themes/demo/draw/front.mustache -p source/themes/demo/draw/reverse.mustache source/themes/demo/draw/data.json source/themes/demo/draw/template.mustache > build/demo/draw.html",
    "demo-simple": "npx mustache -p source/themes/demo/simple/front.mustache -p source/themes/demo/simple/reverse.mustache source/themes/demo/simple/data.json source/themes/demo/simple/template.mustache > build/demo/simple.html",
    "demo-missing": "npx mustache -p source/themes/demo/missing/front.mustache -p source/themes/demo/missing/reverse.mustache source/themes/demo/missing/data.json source/themes/demo/missing/template.mustache > build/demo/missing.html"
  },
  "repository": {
    "type": "git",
    "url": "github:badlydrawnrob/anki"
  },
  "author": "Rob McDonald",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/badlydrawnrob/anki/issues"
  },
  "homepage": "https://github.com/badlydrawnrob/anki#readme",
  "devDependencies": {
    "less": "^4.3.0",
    "mustache": "^4.2.0",
    "print-first-css": "github:badlydrawnrob/print-first-css#b0a9106"
  }
}
